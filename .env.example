# Copy to .env and fill in. This file is committed as a template.

# PostgreSQL connection string (local dev: npm run db:up)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qcocheck?schema=public"

# Auth.js secret — must be >= 32 chars. Generate one: npx auth secret
AUTH_SECRET="replace-with-a-random-32-plus-character-secret-string"

# Canonical app URL. Required in production; optional in development (Auth.js
# infers it from the request host in dev). Set to your deployment URL, e.g.:
# AUTH_URL="https://qcocheck.yourdomain.com"
# AUTH_URL=

# Optional durable storage for batch results and determination PDFs.
# Leave all values blank to use local/on-the-fly storage.
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=

# Production-seed admin credentials (used by prisma/seed.prod.ts).
# Leave blank in development; the dev seed uses fixed demo credentials.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
